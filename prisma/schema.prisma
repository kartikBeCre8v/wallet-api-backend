generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum TransactionType {
  EARN
  SPEND
  EXPIRE
  ADJUST
  REFUND
  BONUS
}

enum SourcePlatform {
  GAMES
  LMS
  SHOPIFY
  ADMIN
  SYSTEM
}

enum EarningCategory {
  ENGAGEMENT
  LEARNING
  ADVOCACY
  PURCHASE
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  childName           String
  childAge            Int
  parentPhone         String     @unique
  shopifyCustomerId   String?
  lmsUserId           String?
  gamesUserId         String?
  promoCardRedeemed   Boolean    @default(false)
  starterCoinCredited Boolean    @default(false)
  status              UserStatus @default(ACTIVE)
  preferredLanguage   String     @default("en")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet Wallet?
  // ✅ ADD THIS LINE
  admin  Admin?
}

model Wallet {
  id     String @id @default(uuid())
  userId String @unique

  balance Int @default(0)

  lifetimeEarned Int @default(0)
  lifetimeSpent  Int @default(0)

  lastActivityAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  transactions Transaction[]
}

model Transaction {
  id String @id @default(uuid())

  walletId String

  type TransactionType

  amount Int

  source String

  sourcePlatform SourcePlatform

  referenceId String?

  description String

  metadata Json?

  balanceAfter Int

  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([referenceId])
  @@index([createdAt])
}

model DailyRewardTracker {
  id String @id @default(uuid())

  userId String

  rewardType String

  rewardDate DateTime

  referenceId String?

  createdAt DateTime @default(now())

  @@index([userId, rewardType, rewardDate])
}

model LoginStreak {
  id String @id @default(uuid())

  userId String @unique

  currentStreak Int @default(0)

  lastLoginDate DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model PlaySession {
  id String @id @default(uuid())

  userId    String
  startedAt DateTime

  endedAt         DateTime?
  durationSeconds Int?
  rewarded        Boolean   @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
}

model SystemConfig {
  id String @id @default(uuid())

  coinValuePaise Int @default(10)

  redemptionCapPercent Int @default(20)

  inactivityExpiryDays Int @default(365)

  starterCoinsAmount Int @default(200)

  dailyGamingCap Int @default(200)

  brandEventActive Boolean @default(false)

  brandEventMultiplier Float @default(1.0)

  brandEventLabel String?

  brandEventUntil DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Admin {
  id     String  @id @default(uuid())
  userId String? @unique

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@map("admin")
}

model EarningRule {
  id String @id @default(uuid())

  ruleKey String @unique

  displayName String

  category EarningCategory

  baseCoins Int

  multiplier Float @default(1.0)

  dailyCap Int?

  totalCap Int?

  requiresModeration Boolean @default(false)

  isActive Boolean @default(true)

  activeFrom DateTime?

  activeUntil DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([ruleKey])
  @@index([category])
}