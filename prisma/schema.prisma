generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model admin {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  userId     String?  @db.VarChar
}

model attempt_answers {
  id          Int      @id @default(autoincrement())
  attempt_id  Int
  question_id Int
  option_id   Int?
  is_correct  Boolean?

  @@index([id], map: "ix_attempt_answers_id")
}

model certificates {
  id              Int       @id @default(autoincrement())
  user_id         Int
  course_id       Int
  issued_at       DateTime? @db.Timestamp(6)
  certificate_url String?   @db.VarChar

  @@index([id], map: "ix_certificates_id")
}

model courses {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar
  description String?
  thumbnail   String?   @db.VarChar
  category    String?   @db.VarChar
  created_by  Int?
  created_at  DateTime? @db.Timestamp(6)
  is_active   Boolean?
  course_code String?   @unique(map: "ix_courses_course_code") @db.VarChar(48)

  @@index([id], map: "ix_courses_id")
}

model creative_submissions {
  id           Int       @id @default(autoincrement())
  user_id      Int
  course_id    Int
  module_id    Int?
  file_url     String    @db.VarChar
  file_type    String?   @db.VarChar
  submitted_at DateTime? @db.Timestamp(6)

  @@index([id], map: "ix_creative_submissions_id")
}

model enrollments {
  id          Int       @id @default(autoincrement())
  user_id     Int
  course_id   Int
  enrolled_at DateTime? @db.Timestamp(6)

  @@index([id], map: "ix_enrollments_id")
}

model lesson_progress {
  id           Int       @id @default(autoincrement())
  user_id      Int
  lesson_id    Int
  completed    Boolean?
  completed_at DateTime? @db.Timestamp(6)

  @@index([id], map: "ix_lesson_progress_id")
}

model lessons {
  id           Int      @id @default(autoincrement())
  course_id    Int
  title        String   @db.VarChar
  content      String?
  video_url    String?  @db.VarChar
  order        Int?
  module_id    Int?
  is_published Boolean? @default(true)

  @@index([id], map: "ix_lessons_id")
}

model modules {
  id        Int    @id @default(autoincrement())
  course_id Int
  title     String @db.VarChar
  order     Int?

  @@index([id], map: "ix_modules_id")
}

model notifications {
  id         Int       @id @default(autoincrement())
  user_id    Int
  message    String    @db.VarChar
  is_read    Boolean?
  created_at DateTime? @db.Timestamp(6)

  @@index([id], map: "ix_notifications_id")
}

model options {
  id          Int      @id @default(autoincrement())
  question_id Int
  text        String   @db.VarChar
  is_correct  Boolean?

  @@index([id], map: "ix_options_id")
}

model progress {
  id           Int       @id @default(autoincrement())
  user_id      Int
  lesson_id    Int
  completed    Boolean?
  completed_at DateTime? @db.Timestamp(6)

  @@index([id], map: "ix_progress_id")
}

model questions {
  id      Int    @id @default(autoincrement())
  quiz_id Int
  text    String
  order   Int?

  @@index([id], map: "ix_questions_id")
}

model quiz_attempts {
  id           Int       @id @default(autoincrement())
  quiz_id      Int
  user_id      Int
  score        Int?
  total        Int?
  submitted_at DateTime? @db.Timestamp(6)

  @@index([id], map: "ix_quiz_attempts_id")
}

model quizzes {
  id          Int       @id @default(autoincrement())
  course_id   Int
  module_id   Int?
  title       String    @db.VarChar
  description String?
  created_at  DateTime? @db.Timestamp(6)

  @@index([id], map: "ix_quizzes_id")
}

model users {
  id            Int      @id @default(autoincrement())
  name          String?  @db.VarChar
  email         String?  @unique(map: "ix_users_email") @db.VarChar
  password      String?  @db.VarChar
  role          String?  @db.VarChar
  auth_provider String?  @default("local") @db.VarChar
  is_blocked    Boolean? @default(false)
  phone         String?  @db.VarChar
  auth_uid      String?  @unique(map: "ix_users_auth_uid") @db.VarChar(36)

  @@index([id], map: "ix_users_id")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum TransactionType {
  EARN
  SPEND
  EXPIRE
  ADJUST
  REFUND
  BONUS
}

enum SourcePlatform {
  GAMES
  LMS
  SHOPIFY
  ADMIN
  SYSTEM
}

enum EarningCategory {
  ENGAGEMENT
  LEARNING
  ADVOCACY
  PURCHASE
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  childName           String
  childAge            Int
  parentPhone         String     @unique
  shopifyCustomerId   String?
  lmsUserId           String?
  gamesUserId         String?
  promoCardRedeemed   Boolean    @default(false)
  starterCoinCredited Boolean    @default(false)
  status              UserStatus @default(ACTIVE)
  preferredLanguage   String     @default("en")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet Wallet?
}

model Wallet {
  id     String @id @default(uuid())
  userId String @unique

  balance Int @default(0)

  lifetimeEarned Int @default(0)
  lifetimeSpent  Int @default(0)

  lastActivityAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  transactions Transaction[]
}

model Transaction {
  id String @id @default(uuid())

  walletId String

  type TransactionType

  amount Int

  source String

  sourcePlatform SourcePlatform

  referenceId String?

  description String

  metadata Json?

  balanceAfter Int

  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([referenceId])
  @@index([createdAt])
}

model DailyRewardTracker {
  id String @id @default(uuid())

  userId String

  rewardType String

  rewardDate DateTime

  referenceId String?

  createdAt DateTime @default(now())

  @@index([userId, rewardType, rewardDate])
}

model LoginStreak {
  id String @id @default(uuid())

  userId String @unique

  currentStreak Int @default(0)

  lastLoginDate DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model PlaySession {
  id String @id @default(uuid())

  userId    String
  startedAt DateTime

  endedAt         DateTime?
  durationSeconds Int?
  rewarded        Boolean   @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
}

model SystemConfig {
  id String @id @default(uuid())

  coinValuePaise Int @default(10)

  redemptionCapPercent Int @default(20)

  inactivityExpiryDays Int @default(365)

  starterCoinsAmount Int @default(200)

  dailyGamingCap Int @default(200)

  brandEventActive Boolean @default(false)

  brandEventMultiplier Float @default(1.0)

  brandEventLabel String?

  brandEventUntil DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model EarningRule {
  id String @id @default(uuid())

  ruleKey String @unique

  displayName String

  category EarningCategory

  baseCoins Int

  multiplier Float @default(1.0)

  dailyCap Int?

  totalCap Int?

  requiresModeration Boolean @default(false)

  isActive Boolean @default(true)

  activeFrom DateTime?

  activeUntil DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([ruleKey])
  @@index([category])
}
